<Window x:Class="DropLAN.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="460"
        Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F3F3F3"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="LanguageButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#DEDEDE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8F8F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F8F8F8"
            BorderBrush="#DADADA"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center">
                <Border Width="42"
                        Height="42"
                        Background="#005FB8"
                        CornerRadius="9"
                        HorizontalAlignment="Center">
                    <TextBlock Text="D"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="DropLAN"
                           Margin="0,10,0,0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="Wybierz język / Choose language"
                           Foreground="#1A1A1A"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Wybór zostanie zapamiętany / Your choice will be remembered"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource LanguageButton}"
                        Click="PolishButton_Click">
                    <StackPanel>
                        <TextBlock Text="🇵🇱" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Polski"
                                   Margin="0,7,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource LanguageButton}"
                        Click="EnglishButton_Click">
                    <StackPanel>
                        <TextBlock Text="🇬🇧" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="English"
                                   Margin="0,7,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="DropLAN • Local transfer"
                       Foreground="#7A7A7A"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
