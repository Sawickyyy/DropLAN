<Window x:Class="DropLAN.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="520"
        Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#090B10"
        AllowsTransparency="True">

    <Border Background="#11151F"
            BorderBrush="#292F3D"
            BorderThickness="1"
            CornerRadius="22"
            Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DropLAN"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0">
                <TextBlock Text="Wybierz język / Choose language"
                           Foreground="#F7F8FB"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Możesz zmienić go później w ustawieniach."
                           Foreground="#7F899B"
                           FontSize="11"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="0,26,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="PolishButton_Click"
                        Cursor="Hand"
                        Background="#191E2A"
                        BorderBrush="#343B4D"
                        BorderThickness="1"
                        Padding="18">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel>
                                    <TextBlock Text="🇵🇱"
                                               FontSize="32"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Polski"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2"
                        Click="EnglishButton_Click"
                        Cursor="Hand"
                        Background="#191E2A"
                        BorderBrush="#343B4D"
                        BorderThickness="1"
                        Padding="18">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel>
                                    <TextBlock Text="🇬🇧"
                                               FontSize="32"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="English"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="DropLAN • Local transfer"
                       Foreground="#626B7D"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
