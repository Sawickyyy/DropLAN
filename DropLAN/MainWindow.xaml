<Window x:Class="DropLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="1120"
        Height="780"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#E8EEF5">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#E8EEF5"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#E8EEF5"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1F5FA"/>
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#DDE5EE"/>
        <SolidColorBrush x:Key="TextBrush" Color="#283448"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#728096"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5878F3"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4969E8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#35A36F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D5DEE8"/>

        <Style x:Key="NeuCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AFBBC8"
                                      BlurRadius="22"
                                      ShadowDepth="7"
                                      Direction="315"
                                      Opacity="0.42"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InsetSurface" TargetType="Border">
            <Setter Property="Background" Value="#E2E9F1"/>
            <Setter Property="BorderBrush" Value="#F7FAFD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="13"/>
        </Style>

        <Style x:Key="NeuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#AEBAC7"
                                                  BlurRadius="13"
                                                  ShadowDepth="4"
                                                  Direction="315"
                                                  Opacity="0.42"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource SurfacePressedBrush}"/>
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentNeuButton"
               TargetType="Button"
               BasedOn="{StaticResource NeuButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#7892F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#5978F3"
                                                  BlurRadius="15"
                                                  ShadowDepth="5"
                                                  Direction="315"
                                                  Opacity="0.32"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#E1E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#F7FAFD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="NeuComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#E1E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#F7FAFD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="122"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="#F8FAFC"
            BorderThickness="1"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="20,10,14,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="15"
                            Background="{StaticResource AccentBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#5878F3"
                                              BlurRadius="18"
                                              ShadowDepth="5"
                                              Opacity="0.28"/>
                        </Border.Effect>
                        <TextBlock Text="D"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="DropLAN"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LanguageLabel}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"/>

                    <ComboBox x:Name="LanguageComboBox"
                              Style="{StaticResource NeuComboBox}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              Margin="0,0,12,0">
                        <ComboBoxItem Tag="pl" Content="Polski"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>

                    <Button Content="—"
                            Width="40"
                            Height="38"
                            Margin="0,0,7,0"
                            Padding="0"
                            Style="{StaticResource NeuButton}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="✕"
                            Width="40"
                            Height="38"
                            Padding="0"
                            Style="{StaticResource NeuButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ResponsiveContentGrid"
                      Margin="22,12,22,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="340"/>
                        <ColumnDefinition x:Name="SpacerColumn" Width="18"/>
                        <ColumnDefinition x:Name="RightColumn" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LeftPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource NeuCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ConnectPhone}"
                                       FontSize="23"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource ScanQrHint}"
                                       Margin="0,5,0,20"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"/>

                            <Border Width="224"
                                    Height="224"
                                    Background="#F7FAFD"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    HorizontalAlignment="Center"
                                    Padding="14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#B4C0CD"
                                                      BlurRadius="18"
                                                      ShadowDepth="5"
                                                      Direction="315"
                                                      Opacity="0.4"/>
                                </Border.Effect>
                                <Image x:Name="QrImage" Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="{DynamicResource Address}"
                                       Margin="0,20,0,7"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                            <Border Style="{StaticResource InsetSurface}">
                                <TextBlock x:Name="AddressText"
                                           TextWrapping="Wrap"
                                           Foreground="#4E5C70"
                                           FontSize="12"/>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="{DynamicResource CopyAddress}"
                                        Style="{StaticResource NeuButton}"
                                        Click="CopyAddressButton_Click"/>
                                <Button Grid.Column="2"
                                        Content="{DynamicResource NewSession}"
                                        Style="{StaticResource NeuButton}"
                                        Click="NewSessionButton_Click"/>
                            </Grid>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PIN"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PinText"
                                               Margin="0,3,0,0"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="1"
                                           Text="…"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="12"/>
                            </Grid>

                            <Separator Margin="0,20,0,18"/>

                            <TextBlock Text="{DynamicResource DownloadFolder}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                            <TextBlock x:Name="DownloadFolderText"
                                       Margin="0,6,0,10"
                                       Foreground="#4E5C70"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="{DynamicResource ChangeFolder}"
                                    Style="{StaticResource NeuButton}"
                                    Click="ChangeFolderButton_Click"/>

                            <Separator Margin="0,20,0,18"/>

                            <TextBlock Text="{DynamicResource Updates}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                            <TextBlock x:Name="VersionText"
                                       Margin="0,6,0,10"
                                       Foreground="#4E5C70"
                                       FontSize="12"/>
                            <Button x:Name="CheckUpdatesButton"
                                    Content="{DynamicResource CheckUpdates}"
                                    Style="{StaticResource NeuButton}"
                                    Click="CheckUpdatesButton_Click"/>
                            <ProgressBar x:Name="UpdateProgress"
                                         Height="7"
                                         Margin="0,12,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#D5DEE8"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RightPanel"
                                Grid.Row="0"
                                Grid.Column="2">
                        <Border x:Name="DropZone"
                                Style="{StaticResource NeuCard}"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource ShareFiles}"
                                               FontSize="21"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource DropFilesHint}"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource AddFiles}"
                                        Margin="18,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AccentNeuButton}"
                                        Click="AddFilesButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Style="{StaticResource NeuCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ReadyToDownload}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource PhoneAutoRefresh}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button Content="{DynamicResource Remove}"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource NeuButton}"
                                                Click="RemoveSelectedButton_Click"/>
                                        <Button Content="{DynamicResource Clear}"
                                                Style="{StaticResource NeuButton}"
                                                Click="ClearSharedButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,15,0,0"
                                        Style="{StaticResource InsetSurface}">
                                    <ListBox x:Name="SharedFilesList"
                                             MinHeight="105"
                                             DisplayMemberPath="DisplayLabel"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Style="{StaticResource NeuCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clipboard}"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource ClipboardHint}"
                                           Margin="0,4,0,12"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"/>
                                <TextBox x:Name="ClipboardTextBox"
                                         Style="{StaticResource NeuTextBox}"
                                         MinHeight="105"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{DynamicResource ReadClipboard}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource NeuButton}"
                                            Click="ReadWindowsClipboardButton_Click"/>
                                    <Button Content="{DynamicResource Publish}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource AccentNeuButton}"
                                            Click="PublishClipboardButton_Click"/>
                                    <Button Content="{DynamicResource WriteClipboard}"
                                            Margin="0,0,0,8"
                                            Style="{StaticResource NeuButton}"
                                            Click="WriteWindowsClipboardButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Style="{StaticResource NeuCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TransferHistory}"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <Border Margin="0,12,0,0"
                                        Style="{StaticResource InsetSurface}">
                                    <ListBox x:Name="HistoryList"
                                             MinHeight="135"
                                             DisplayMemberPath="DisplayLabel"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
