<Window x:Class="DropLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="1180"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- Fluent Hub design tokens -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F9FAFC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F6FC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Windows 11-like title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="D" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DropLAN" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,7,8,7">
                    <Button Content="—" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowControlButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="10,14,10,4">
                            <Button x:Name="NavHomeButton" Tag="selected" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="Home">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="19" Width="30"/><TextBlock x:Name="NavHomeText" Text="{DynamicResource NavHome}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="NavSendButton" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="Send">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="↑" FontSize="19" Width="30"/><TextBlock x:Name="NavSendText" Text="{DynamicResource NavSend}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="NavReceiveButton" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="Receive">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="19" Width="30"/><TextBlock x:Name="NavReceiveText" Text="{DynamicResource NavReceive}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="NavClipboardButton" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="Clipboard">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="17" Width="30"/><TextBlock x:Name="NavClipboardText" Text="{DynamicResource NavClipboard}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="NavHistoryButton" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="History">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="18" Width="30"/><TextBlock x:Name="NavHistoryText" Text="{DynamicResource NavHistory}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="10,4,10,12">
                            <Separator Margin="8,4,8,8" Background="{DynamicResource BorderBrush}"/>
                            <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="NavButton_Click" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Width="30"/><TextBlock x:Name="NavSettingsText" Text="{DynamicResource NavSettings}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <StackPanel Margin="16,10,12,2">
                                <TextBlock x:Name="SidebarStatusLabel" Text="{DynamicResource ServerStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="SidebarStatusText" Text="● …" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,10,28,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="{DynamicResource HomeTitle}" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitleText" Text="{DynamicResource HomeSubtitle}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TopStatusText" Text="{DynamicResource Ready}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ContentHost" Margin="28,8,28,28">
                            <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>

                            <!-- HOME -->
                            <Grid x:Name="HomePage">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="{DynamicResource PairTitle}" FontSize="23" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource PairSubtitle}" Margin="0,6,0,18" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="PIN" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                            <TextBlock x:Name="PinText" FontSize="38" FontWeight="SemiBold" Margin="0,2,0,12"/>
                                            <TextBlock x:Name="StatusText" Text="…" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                                            <Button Content="{DynamicResource NewSession}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="NewSessionButton_Click"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="232" Height="232" HorizontalAlignment="Center" Background="White" CornerRadius="16" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Image x:Name="QrImage" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource QuickActions}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource QuickActionsHint}" Margin="0,4,0,16" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="{DynamicResource GoSend}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,9" Click="GoSendButton_Click"/>
                                        <Button Content="{DynamicResource OpenDownloadFolder}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" Click="OpenDownloadFolderButton_Click"/>
                                        <Button Content="{DynamicResource GoClipboard}" Style="{StaticResource SecondaryButton}" Click="GoClipboardButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid><TextBlock Text="{DynamicResource RecentTransfers}" FontSize="16" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{DynamicResource ViewAll}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="11,6" Click="GoHistoryButton_Click"/></Grid>
                                        <ListBox x:Name="HomeRecentList" Margin="0,12,0,0" MinHeight="110" MaxHeight="180" DisplayMemberPath="DisplayLabel"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SEND -->
                            <Grid x:Name="SendPage" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="DropZone" Style="{StaticResource Card}" AllowDrop="True" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Padding="30">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{DynamicResource ShareFiles}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource DropFilesHint}" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource AddFiles}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="AddFilesButton_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid><StackPanel><TextBlock Text="{DynamicResource ReadyToDownload}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource PhoneAutoRefresh}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Remove}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveSelectedButton_Click"/><Button Content="{DynamicResource Clear}" Style="{StaticResource SecondaryButton}" Click="ClearSharedButton_Click"/></StackPanel></Grid>
                                        <ListBox x:Name="SharedFilesList" Margin="0,14,0,0" MinHeight="220" DisplayMemberPath="DisplayLabel"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- RECEIVE -->
                            <Grid x:Name="ReceivePage" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{DynamicResource DownloadFolder}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DownloadFolderText" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource OpenFolder}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenDownloadFolderButton_Click"/><Button Content="{DynamicResource ChangeFolder}" Style="{StaticResource PrimaryButton}" Click="ChangeFolderButton_Click"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource Card}">
                                    <StackPanel><TextBlock Text="{DynamicResource ReceivedRecently}" FontSize="16" FontWeight="SemiBold"/><ListBox x:Name="ReceivedHistoryList" Margin="0,12,0,0" MinHeight="260" DisplayMemberPath="DisplayLabel"/></StackPanel>
                                </Border>
                            </Grid>

                            <!-- CLIPBOARD -->
                            <Grid x:Name="ClipboardPage" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="26">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Clipboard}" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource ClipboardHint}" Margin="0,5,0,18" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBox x:Name="ClipboardTextBox" Style="{StaticResource FluentTextBox}" MinHeight="260" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="{DynamicResource ReadClipboard}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ReadWindowsClipboardButton_Click"/>
                                            <Button Content="{DynamicResource Publish}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="PublishClipboardButton_Click"/>
                                            <Button Content="{DynamicResource WriteClipboard}" Style="{StaticResource SecondaryButton}" Click="WriteWindowsClipboardButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- HISTORY -->
                            <Grid x:Name="HistoryPage" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TransferHistory}" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource HistoryHint}" Margin="0,5,0,14" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <ListBox x:Name="HistoryList" MinHeight="390" DisplayMemberPath="DisplayLabel"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SETTINGS -->
                            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel><TextBlock Text="{DynamicResource Appearance}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AppearanceHint}" Margin="0,4,0,14" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                            <TextBlock Text="{DynamicResource LanguageLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="LanguageComboBox" Style="{StaticResource FluentComboBox}" Margin="0,6,0,14" SelectionChanged="LanguageComboBox_SelectionChanged"><ComboBoxItem Tag="pl" Content="Polski"/><ComboBoxItem Tag="en" Content="English"/></ComboBox>
                                            <TextBlock Text="{DynamicResource Theme}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="ThemeComboBox" Style="{StaticResource FluentComboBox}" Margin="0,6,0,0" SelectionChanged="ThemeComboBox_SelectionChanged"><ComboBoxItem Tag="system" Content="System"/><ComboBoxItem Tag="light" Content="Light"/><ComboBoxItem Tag="dark" Content="Dark"/></ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="{DynamicResource Behavior}" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="MinimizeToTrayCheckBox" Content="{DynamicResource MinimizeToTray}" Margin="0,14,0,8" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed"/><CheckBox x:Name="NotificationsCheckBox" Content="{DynamicResource TransferNotifications}" Margin="0,0,0,8" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed"/><CheckBox x:Name="AutoUpdatesCheckBox" Content="{DynamicResource AutoCheckUpdates}" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed"/></StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel><TextBlock Text="{DynamicResource Updates}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Margin="0,8,0,10" Foreground="{DynamicResource MutedBrush}"/><Button x:Name="CheckUpdatesButton" Content="{DynamicResource CheckUpdates}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CheckUpdatesButton_Click"/><ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,12,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/><TextBlock x:Name="UpdateStatusText" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="{DynamicResource About}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="DropLAN" Margin="0,12,0,0" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AboutText}" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
