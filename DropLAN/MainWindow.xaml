<Window x:Class="DropLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="1060"
        Height="720"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FBFBFB"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlHover" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="ControlPressed" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#616161"/>
        <SolidColorBrush x:Key="Stroke" Color="#E2E2E2"/>
        <SolidColorBrush x:Key="Accent" Color="#005FB8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0067C0"/>
        <SolidColorBrush x:Key="Success" Color="#0F7B0F"/>

        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#18000000"
                                      BlurRadius="14"
                                      ShadowDepth="2"
                                      Opacity="0.22"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleSurface" TargetType="Border">
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource FluentButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource Stroke}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="#DADADA"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#F8F8F8"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="7"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="D"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DropLAN"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LanguageLabel}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox x:Name="LanguageComboBox"
                              Style="{StaticResource FluentComboBox}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              Margin="0,0,10,0">
                        <ComboBoxItem Tag="pl" Content="Polski"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
                    <Button Content="—"
                            Style="{StaticResource TitleButton}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="✕"
                            Style="{StaticResource TitleButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ResponsiveContentGrid"
                      Margin="20,18,20,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="340"/>
                        <ColumnDefinition x:Name="SpacerColumn" Width="18"/>
                        <ColumnDefinition x:Name="RightColumn" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LeftPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ConnectPhone}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource ScanQrHint}"
                                       Margin="0,4,0,18"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"/>

                            <Border Width="220"
                                    Height="220"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    BorderBrush="#E2E2E2"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <Image x:Name="QrImage" Stretch="Uniform"/>
                            </Border>

                            <!-- Adres jest celowo niewidoczny. QR jest jedynym sposobem parowania z UI. -->
                            <TextBlock x:Name="AddressText" Visibility="Collapsed"/>

                            <Button Content="{DynamicResource NewSession}"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource FluentButton}"
                                    Click="NewSessionButton_Click"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PIN"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="PinText"
                                               Margin="0,2,0,0"
                                               FontSize="30"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="#EAF5EA"
                                        CornerRadius="12"
                                        Padding="10,6">
                                    <TextBlock x:Name="StatusText"
                                               Text="…"
                                               Foreground="{StaticResource Success}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Separator Margin="0,18,0,16"/>

                            <TextBlock Text="{DynamicResource DownloadFolder}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="DownloadFolderText"
                                       Margin="0,5,0,10"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="{DynamicResource ChangeFolder}"
                                    Style="{StaticResource FluentButton}"
                                    Click="ChangeFolderButton_Click"/>

                            <Separator Margin="0,18,0,16"/>

                            <TextBlock Text="{DynamicResource Updates}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="VersionText"
                                       Margin="0,5,0,9"
                                       FontSize="12"/>
                            <Button x:Name="CheckUpdatesButton"
                                    Content="{DynamicResource CheckUpdates}"
                                    Style="{StaticResource FluentButton}"
                                    Click="CheckUpdatesButton_Click"/>
                            <ProgressBar x:Name="UpdateProgress"
                                         Height="6"
                                         Margin="0,10,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Foreground="{StaticResource Accent}"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RightPanel"
                                Grid.Row="0"
                                Grid.Column="2">
                        <Border x:Name="DropZone"
                                Style="{StaticResource FluentCard}"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource ShareFiles}"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource DropFilesHint}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource AddFiles}"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AccentButton}"
                                        Click="AddFilesButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ReadyToDownload}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource PhoneAutoRefresh}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{DynamicResource Remove}"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource FluentButton}"
                                                Click="RemoveSelectedButton_Click"/>
                                        <Button Content="{DynamicResource Clear}"
                                                Style="{StaticResource FluentButton}"
                                                Click="ClearSharedButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,12,0,0" Style="{StaticResource SubtleSurface}">
                                    <ListBox x:Name="SharedFilesList"
                                             MinHeight="76"
                                             DisplayMemberPath="DisplayLabel"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clipboard}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource ClipboardHint}"
                                           Margin="0,3,0,10"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="ClipboardTextBox"
                                         MinHeight="82"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource FluentTextBox}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{DynamicResource ReadClipboard}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource FluentButton}"
                                            Click="ReadWindowsClipboardButton_Click"/>
                                    <Button Content="{DynamicResource Publish}"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource AccentButton}"
                                            Click="PublishClipboardButton_Click"/>
                                    <Button Content="{DynamicResource WriteClipboard}"
                                            Margin="0,0,0,8"
                                            Style="{StaticResource FluentButton}"
                                            Click="WriteWindowsClipboardButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TransferHistory}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <Border Margin="0,10,0,0" Style="{StaticResource SubtleSurface}">
                                    <ListBox x:Name="HistoryList"
                                             MinHeight="92"
                                             DisplayMemberPath="DisplayLabel"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
