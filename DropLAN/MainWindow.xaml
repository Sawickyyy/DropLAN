<Window x:Class="DropLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLAN"
        Width="1080"
        Height="760"
        MinWidth="940"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#090B10">

    <Window.Resources>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#202534"/>
            <Setter Property="BorderBrush" Value="#303749"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#2A3042"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6F5CFF"/>
            <Setter Property="BorderBrush" Value="#8475FF"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#11151F"/>
            <Setter Property="BorderBrush" Value="#222938"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7F8FB"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E9ECF3"/>
        </Style>

    </Window.Resources>

    <Border Background="#090B10"
            BorderBrush="#202533"
            BorderThickness="1"
            CornerRadius="18">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Pasek tytułu -->
            <Grid Grid.Row="0"
                  Margin="10,4,8,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <Border Width="32"
                            Height="32"
                            CornerRadius="10"
                            Background="#6F5CFF">

                        <TextBlock Text="D"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="DropLAN"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Local transfer"
                                   FontSize="10"
                                   Foreground="#70798B"/>

                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="—"
                            Width="38"
                            Height="32"
                            Margin="0,0,5,0"
                            Style="{StaticResource ModernButton}"
                            Click="MinimizeButton_Click"/>

                    <Button Content="✕"
                            Width="38"
                            Height="32"
                            Style="{StaticResource ModernButton}"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

            <!-- Treść -->
            <Grid Grid.Row="1"
                  Margin="18,8,18,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lewy panel -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Połącz telefon"
                                       FontSize="22"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Zeskanuj QR, potem wpisz PIN."
                                       Margin="0,6,0,18"
                                       Foreground="#8892A5"
                                       FontSize="12"/>

                            <Border Width="238"
                                    Height="238"
                                    Background="White"
                                    CornerRadius="18"
                                    HorizontalAlignment="Center"
                                    Padding="12">

                                <Image x:Name="QrImage"
                                       Stretch="Uniform"/>

                            </Border>

                            <TextBlock Text="Adres"
                                       Margin="0,18,0,6"
                                       Foreground="#727D91"
                                       FontSize="11"/>

                            <Border Background="#0B0E15"
                                    BorderBrush="#242B3A"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="11">

                                <TextBlock x:Name="AddressText"
                                           TextWrapping="Wrap"
                                           Foreground="#B9C1D1"
                                           FontSize="12"/>

                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="Kopiuj adres"
                                        Style="{StaticResource ModernButton}"
                                        Click="CopyAddressButton_Click"/>

                                <Button Grid.Column="2"
                                        Content="Nowa sesja"
                                        Style="{StaticResource ModernButton}"
                                        Click="NewSessionButton_Click"/>
                            </Grid>

                            <TextBlock Text="PIN"
                                       Margin="0,22,0,5"
                                       Foreground="#727D91"
                                       FontSize="11"/>

                            <TextBlock x:Name="PinText"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"/>

                            <TextBlock x:Name="StatusText"
                                       Text="Uruchamianie…"
                                       Margin="0,10,0,0"
                                       Foreground="#56D88C"
                                       FontSize="12"/>

                            <Separator Margin="0,20,0,18"
                                       Background="#222938"/>

                            <TextBlock Text="Folder odbiorczy"
                                       Foreground="#727D91"
                                       FontSize="11"/>

                            <TextBlock x:Name="DownloadFolderText"
                                       Margin="0,6,0,10"
                                       Foreground="#B9C1D1"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <Button Content="Zmień folder"
                                    Style="{StaticResource ModernButton}"
                                    Click="ChangeFolderButton_Click"/>

                            <Separator Margin="0,20,0,18"
                                       Background="#222938"/>

                            <TextBlock Text="Aktualizacje"
                                       Foreground="#727D91"
                                       FontSize="11"/>

                            <TextBlock x:Name="VersionText"
                                       Margin="0,6,0,10"
                                       Foreground="#B9C1D1"
                                       FontSize="12"/>

                            <Button x:Name="CheckUpdatesButton"
                                    Content="Sprawdź aktualizacje"
                                    Style="{StaticResource ModernButton}"
                                    Click="CheckUpdatesButton_Click"/>

                            <ProgressBar x:Name="UpdateProgress"
                                         Height="6"
                                         Margin="0,10,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"/>

                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,7,0,0"
                                       Foreground="#7F899B"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

                <!-- Prawy panel -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Drag drop -->
                        <Border x:Name="DropZone"
                                Style="{StaticResource CardBorder}"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Udostępnij pliki"
                                               FontSize="20"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Przeciągnij tutaj pliki albo wybierz je ręcznie."
                                               Margin="0,5,0,0"
                                               Foreground="#8892A5"
                                               FontSize="12"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="+ Dodaj pliki"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AccentButton}"
                                        Click="AddFilesButton_Click"/>

                            </Grid>

                        </Border>

                        <!-- Shared files -->
                        <Border Margin="0,14,0,0"
                                Style="{StaticResource CardBorder}">

                            <StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Gotowe do pobrania"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Strona na telefonie aktualizuje się automatycznie."
                                                   Margin="0,4,0,0"
                                                   Foreground="#7F899B"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">

                                        <Button Content="Usuń"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource ModernButton}"
                                                Click="RemoveSelectedButton_Click"/>

                                        <Button Content="Wyczyść"
                                                Style="{StaticResource ModernButton}"
                                                Click="ClearSharedButton_Click"/>

                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="SharedFilesList"
                                         Margin="0,14,0,0"
                                         MinHeight="100"
                                         DisplayMemberPath="DisplayLabel"/>

                            </StackPanel>

                        </Border>

                        <!-- Clipboard -->
                        <Border Margin="0,14,0,0"
                                Style="{StaticResource CardBorder}">

                            <StackPanel>

                                <TextBlock Text="Schowek"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Tekst synchronizowany w czasie rzeczywistym."
                                           Margin="0,4,0,10"
                                           Foreground="#7F899B"
                                           FontSize="11"/>

                                <TextBox x:Name="ClipboardTextBox"
                                         MinHeight="90"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="12"
                                         Background="#0B0E15"
                                         Foreground="#F1F3F7"
                                         BorderBrush="#252D3E"
                                         BorderThickness="1"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Button Content="Pobierz ze schowka Windows"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ModernButton}"
                                            Click="ReadWindowsClipboardButton_Click"/>

                                    <Button Content="Udostępnij"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource AccentButton}"
                                            Click="PublishClipboardButton_Click"/>

                                    <Button Content="Kopiuj do Windows"
                                            Style="{StaticResource ModernButton}"
                                            Click="WriteWindowsClipboardButton_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <!-- History -->
                        <Border Margin="0,14,0,0"
                                Style="{StaticResource CardBorder}">

                            <StackPanel>
                                <TextBlock Text="Historia transferów"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <ListBox x:Name="HistoryList"
                                         Margin="0,10,0,0"
                                         MinHeight="130"
                                         DisplayMemberPath="DisplayLabel"/>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Border>
</Window>
